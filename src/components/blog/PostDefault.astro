---
const { post } = Astro.props as { post: any };
const { Content } = await post.render();
const d = post.data;
const fmt = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const TAG_MAP: Record<string, string> = {
  'Big Data': 'tag-bigdata', 'Azure': 'tag-azure', 'Machine Learning': 'tag-ml',
  'IoT': 'tag-iot', '.NET': 'tag-dotnet', 'Architecture': 'tag-arch',
};
const tagCls = TAG_MAP[d.tag] ?? 'tag-azure';
---
<div class="bp-cover"
  style={d.coverImage
    ? `background-image:url(${d.coverImage});background-size:cover;background-position:center`
    : `background:var(--dark-surface)`}>
</div>

<div class="bp-content">
  <div class="blog-breadcrumb">
    <a href="/blog">Blog</a><span>/</span><span>{d.tag}</span>
  </div>
  <div class="bp-tag-row"><span class={`tag ${tagCls}`}>{d.tag}</span></div>
  <h1 class="bp-h1">{d.title}</h1>
  <div class="bp-meta">
    <div class="bp-avatar"></div>
    <span style="font-weight:500;color:var(--fg1)">{d.author}</span>
    <span>·</span><span>{fmt(d.date)}</span>
    {d.readTime && <><span>·</span><span>{d.readTime} read</span></>}
  </div>
  <div class="bp-share">
    <span>Share</span>
    <button class="share-btn" aria-label="Copy link">
      <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
    </button>
    <button class="share-btn" aria-label="Share on LinkedIn">
      <svg viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
    </button>
    <button class="share-btn" aria-label="Share on X">
      <svg viewBox="0 0 24 24"><path d="M4 4l16 16M4 20L20 4"/></svg>
    </button>
  </div>
  <article class="art-body" style="margin-top:48px">
    <Content />
  </article>
  <div class="bp-author-foot">
    <div class="bp-author-big"></div>
    <div>
      <div class="bp-author-name">{d.author}</div>
      <div class="bp-author-role">{d.authorRole ?? 'Veloxcore'}</div>
    </div>
  </div>
</div>
