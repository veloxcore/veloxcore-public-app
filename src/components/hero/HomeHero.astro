---
import HeroCanvas from './HeroCanvas.astro';
import WordRotator from './WordRotator.astro';
import DeviceMock from './DeviceMock.astro';
import FloatChip from './FloatChip.astro';
import ButtonPill from '../ui/ButtonPill.astro';
---
<section class="hero" data-screen-label="01 Hero">
  <HeroCanvas />
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <div class="hero-tag"><span class="dot"></span>Microsoft Solutions Partner — Data &amp; AI &nbsp;·&nbsp; AI-Native Engineering</div>
        <h1 class="hero-h1">The studio that ships <WordRotator /></h1>
        <p class="hero-sub">Not demos. Not proofs-of-concept. Production-grade AI for enterprise and growth-stage teams — LLM pipelines, autonomous agents, RAG systems — built on Azure by engineers who run their own AI products.</p>
        <div class="hero-acts">
          <ButtonPill variant="dark" href="/contact">Book a discovery call</ButtonPill>
          <ButtonPill variant="soft" href="/work" arrow>See our work</ButtonPill>
        </div>
      </div>
      <div class="hero-device">
        <DeviceMock />
        <FloatChip />
      </div>
    </div>
  </div>
</section>
