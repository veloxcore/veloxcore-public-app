---
import DotField from './DotField.astro';
import ButtonPill from '../ui/ButtonPill.astro';
---
<section class="cta" data-screen-label="05 CTA">
  <DotField />
  <div class="wrap">
    <h2>Ship production AI. Sooner.</h2>
    <p>We take enterprise teams from first LLM prototype to production-grade AI — on Azure, in weeks. Let's talk about your project.</p>
    <div class="cta-acts">
      <ButtonPill variant="dark" href="/contact">Get in touch</ButtonPill>
      <ButtonPill variant="soft" href="/services" arrow>Explore services</ButtonPill>
    </div>
  </div>
</section>
