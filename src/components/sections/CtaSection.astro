---
import DotField from './DotField.astro';
---
<section class="cta" data-screen-label="05 CTA">
  <DotField />
  <div class="wrap">
    <h2>Unleash the value of your data.</h2>
    <p>Be it big or small, we help you understand and act on the data you already possess. Let's talk.</p>
    <div class="cta-acts">
      <a class="btn-pill btn-dark">Get in touch</a>
      <a class="btn-pill btn-soft">Explore services <span class="arr">→</span></a>
    </div>
  </div>
</section>
