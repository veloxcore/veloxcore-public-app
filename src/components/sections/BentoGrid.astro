---
// Multi-Agent System bento grid — ported from the canonical Veloxcore Home.html
// design bundle (section "03b"). CSS-only card visuals via inline SVG/SMIL;
// the live log stream + latency sparkline are driven by the script below.
---
<section class="bento-section" data-screen-label="03b Multi-Agent System">
  <div class="wrap">

    <div class="bento-head">
      <div class="reveal">
        <span class="sec-eyebrow">Multi-Agent System</span>
        <h2 class="sec-h2" style="color:var(--fg1);margin-bottom:16px">Agents that coordinate,<br>reason, and execute.</h2>
        <p class="sec-sub" style="color:var(--fg2);margin-bottom:0;max-width:46ch">Specialist agents — Research, Code, Writer, QA — orchestrated live on Azure AI Foundry. Humans stay in the loop at every critical step.</p>
      </div>
      <div style="flex-shrink:0">
        <a class="btn-pill" href="/services/ai-agents" style="background:rgba(26,115,232,.07);color:var(--accent);border:1px solid rgba(26,115,232,.18);font-size:15px;white-space:nowrap">See AI Agents →</a>
      </div>
    </div>

    <div class="bento-grid">

      <!-- ① AGENT NETWORK — 2×2 -->
      <div class="bento-card bn-net">
        <div style="position:absolute;top:20px;left:24px;z-index:3;pointer-events:none">
          <div class="b-eye" style="margin-bottom:2px">Agent Network</div>
          <div style="font-size:13px;color:var(--fg2);letter-spacing:-.01em">5 agents · live orchestration</div>
        </div>
        <div style="position:absolute;bottom:20px;left:24px;z-index:3;display:flex;gap:16px;pointer-events:none">
          <div style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--fg3)"><span style="width:6px;height:6px;border-radius:50%;background:#16a34a;box-shadow:0 0 7px rgba(0,221,106,.8);display:inline-block"></span>Active</div>
          <div style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--fg3)"><span style="width:6px;height:6px;border-radius:50%;background:#d97706;box-shadow:0 0 7px rgba(254,188,46,.8);display:inline-block"></span>Processing</div>
          <div style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--fg3)"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 7px rgba(61,126,255,.8);display:inline-block"></span>Ready</div>
        </div>
        <div style="position:absolute;top:20px;right:20px;z-index:3;background:rgba(22,163,74,.10);border:1px solid rgba(22,163,74,.22);border-radius:9999px;padding:5px 13px;display:flex;align-items:center;gap:7px;pointer-events:none">
          <span style="width:6px;height:6px;border-radius:50%;background:#16a34a;animation:pulse 1.4s ease-out infinite;box-shadow:0 0 7px rgba(22,163,74,.5)"></span>
          <span style="font-size:11px;color:#16a34a;font-weight:500;letter-spacing:-.01em">847 tasks / hr</span>
        </div>

        <!-- SVG NETWORK VISUALIZATION (animated via SMIL; blur filter removed for perf) -->
        <svg width="100%" height="100%" viewBox="0 0 660 425" preserveAspectRatio="xMidYMid slice"
             fill="none" xmlns="http://www.w3.org/2000/svg"
             style="position:absolute;inset:0">
          <defs>
            <path id="bn-lr" d="M330,207 Q229,148 130,92"/>
            <path id="bn-lc" d="M330,207 Q431,148 530,92"/>
            <path id="bn-lw" d="M330,207 Q431,262 530,318"/>
            <path id="bn-lq" d="M330,207 Q229,262 130,318"/>
            <path id="bn-lp" d="M330,207 L330,363"/>
            <radialGradient id="bn-orch-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(26,115,232,.18)"/>
              <stop offset="100%" stop-color="rgba(61,126,255,0)"/>
            </radialGradient>
          </defs>

          <circle cx="330" cy="207" r="66"  fill="none" stroke="rgba(26,115,232,.12)" stroke-width="1" stroke-dasharray="3 5"/>
          <circle cx="330" cy="207" r="112" fill="none" stroke="rgba(26,115,232,.09)" stroke-width="1" stroke-dasharray="2 7"/>
          <circle cx="330" cy="207" r="158" fill="none" stroke="rgba(26,115,232,.06)" stroke-width="1" stroke-dasharray="2 9"/>

          <path d="M330,207 Q229,148 130,92"  stroke="rgba(26,115,232,.35)" stroke-width="1.5" stroke-dasharray="5 4"/>
          <path d="M330,207 Q431,148 530,92"  stroke="rgba(6,182,212,.35)"  stroke-width="1.5" stroke-dasharray="5 4"/>
          <path d="M330,207 Q431,262 530,318" stroke="rgba(22,163,74,.35)"  stroke-width="1.5" stroke-dasharray="5 4"/>
          <path d="M330,207 Q229,262 130,318" stroke="rgba(217,119,6,.35)" stroke-width="1.5" stroke-dasharray="5 4"/>
          <path d="M330,207 L330,363"         stroke="rgba(26,115,232,.25)" stroke-width="1.5" stroke-dasharray="5 4"/>

          <!-- animated data packets (no blur filter) -->
          <circle r="4" fill="var(--viz-blue)" opacity=".95"><animateMotion dur="2.4s" repeatCount="indefinite" begin="0s"><mpath href="#bn-lr"/></animateMotion></circle>
          <circle r="2.5" fill="var(--viz-blue)" opacity=".55"><animateMotion dur="2.4s" repeatCount="indefinite" begin="1.2s"><mpath href="#bn-lr"/></animateMotion></circle>
          <circle r="2.5" fill="var(--viz-cyan)" opacity=".7"><animateMotion dur="2.1s" repeatCount="indefinite" begin="0.7s" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#bn-lr"/></animateMotion></circle>
          <circle r="4" fill="var(--viz-cyan)" opacity=".95"><animateMotion dur="1.9s" repeatCount="indefinite" begin="0.4s"><mpath href="#bn-lc"/></animateMotion></circle>
          <circle r="2" fill="var(--viz-cyan)" opacity=".5"><animateMotion dur="1.9s" repeatCount="indefinite" begin="1.35s" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#bn-lc"/></animateMotion></circle>
          <circle r="3.5" fill="var(--viz-green)" opacity=".9"><animateMotion dur="2.6s" repeatCount="indefinite" begin="0.8s"><mpath href="#bn-lw"/></animateMotion></circle>
          <circle r="2.5" fill="var(--viz-green)" opacity=".5"><animateMotion dur="2.6s" repeatCount="indefinite" begin="1.9s" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#bn-lw"/></animateMotion></circle>
          <circle r="3.5" fill="#febc2e" opacity=".9"><animateMotion dur="2.2s" repeatCount="indefinite" begin="1.1s"><mpath href="#bn-lq"/></animateMotion></circle>
          <circle r="2" fill="#febc2e" opacity=".5"><animateMotion dur="2.2s" repeatCount="indefinite" begin="0.1s" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#bn-lq"/></animateMotion></circle>
          <circle r="3" fill="var(--accent-soft)" opacity=".8"><animateMotion dur="1.7s" repeatCount="indefinite" begin="0.5s"><mpath href="#bn-lp"/></animateMotion></circle>
          <circle r="2" fill="var(--accent-soft)" opacity=".45"><animateMotion dur="1.7s" repeatCount="indefinite" begin="1.35s" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#bn-lp"/></animateMotion></circle>

          <circle cx="330" cy="207" r="56" fill="url(#bn-orch-glow)">
            <animate attributeName="r" values="52;62;52" dur="4s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values=".8;.2;.8" dur="4s" repeatCount="indefinite"/>
          </circle>
          <circle cx="330" cy="207" r="38" fill="rgba(26,115,232,.07)" stroke="rgba(26,115,232,.30)" stroke-width="1.5"/>
          <circle cx="330" cy="207" r="26" fill="#ffffff" stroke="rgba(26,115,232,.75)" stroke-width="1.5"/>
          <path d="M330,196 L338,207 L330,218 L322,207 Z" fill="rgba(26,115,232,.18)" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round"/>
          <circle cx="330" cy="207" r="3.5" fill="var(--accent)"/>
          <text x="330" y="250" text-anchor="middle" fill="rgba(30,33,36,.75)" font-size="11" font-family="Google Sans,system-ui,sans-serif" letter-spacing="-.02em">Orchestrator</text>

          <circle cx="130" cy="92" r="26" fill="rgba(26,115,232,.07)" stroke="rgba(26,115,232,.30)" stroke-width="1.5"/>
          <circle cx="130" cy="92" r="17" fill="#ffffff"/>
          <circle cx="129" cy="90" r="6"  fill="none" stroke="var(--accent)" stroke-width="1.5"/>
          <line   x1="133.5" y1="95" x2="137.5" y2="99" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round"/>
          <circle cx="148" cy="76" r="5" fill="#16a34a"><animate attributeName="opacity" values="1;.3;1" dur="2.1s" repeatCount="indefinite"/></circle>
          <text x="130" y="129" text-anchor="middle" fill="rgba(50,55,60,.8)" font-size="10.5" font-family="Google Sans,system-ui,sans-serif">Research</text>

          <circle cx="530" cy="92" r="26" fill="rgba(6,182,212,.07)" stroke="rgba(6,182,212,.35)" stroke-width="1.5"/>
          <circle cx="530" cy="92" r="17" fill="#ffffff"/>
          <path d="M526,86 L521,92 L526,98" fill="none" stroke="#0891b2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M534,86 L539,92 L534,98" fill="none" stroke="#0891b2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="548" cy="76" r="5" fill="#d97706"><animate attributeName="opacity" values="1;.3;1" dur="1.6s" repeatCount="indefinite"/></circle>
          <text x="530" y="129" text-anchor="middle" fill="rgba(50,55,60,.8)" font-size="10.5" font-family="Google Sans,system-ui,sans-serif">Code Agent</text>

          <circle cx="530" cy="318" r="26" fill="rgba(22,163,74,.07)" stroke="rgba(22,163,74,.35)" stroke-width="1.5"/>
          <circle cx="530" cy="318" r="17" fill="#ffffff"/>
          <path d="M525,322 L530,312 L536,318 L531,328 L526,327 Z" fill="none" stroke="#16a34a" stroke-width="1.4" stroke-linejoin="round"/>
          <line x1="525" y1="322" x2="522" y2="325" stroke="#16a34a" stroke-width="1.4" stroke-linecap="round"/>
          <circle cx="548" cy="302" r="5" fill="#16a34a"><animate attributeName="opacity" values="1;.3;1" dur="1.9s" repeatCount="indefinite"/></circle>
          <text x="530" y="355" text-anchor="middle" fill="rgba(50,55,60,.8)" font-size="10.5" font-family="Google Sans,system-ui,sans-serif">Writer</text>

          <circle cx="130" cy="318" r="26" fill="rgba(217,119,6,.07)" stroke="rgba(217,119,6,.35)" stroke-width="1.5"/>
          <circle cx="130" cy="318" r="17" fill="#ffffff"/>
          <path d="M123,318 L128,323 L137,313" fill="none" stroke="#d97706" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="148" cy="302" r="5" fill="#16a34a"><animate attributeName="opacity" values="1;.4;1" dur="2.3s" repeatCount="indefinite"/></circle>
          <text x="130" y="355" text-anchor="middle" fill="rgba(50,55,60,.8)" font-size="10.5" font-family="Google Sans,system-ui,sans-serif">QA Agent</text>

          <circle cx="330" cy="368" r="24" fill="rgba(26,115,232,.06)" stroke="rgba(26,115,232,.25)" stroke-width="1.5"/>
          <circle cx="330" cy="368" r="16" fill="#ffffff"/>
          <rect x="323" y="361" width="6" height="6" rx="1.5" fill="var(--accent)" opacity=".85"/>
          <rect x="331" y="361" width="6" height="6" rx="1.5" fill="var(--accent)" opacity=".5"/>
          <rect x="323" y="369" width="6" height="6" rx="1.5" fill="var(--accent)"/>
          <rect x="331" y="369" width="6" height="6" rx="1.5" fill="var(--accent)" opacity=".35"/>
          <circle cx="346" cy="354" r="5" fill="var(--accent)"><animate attributeName="opacity" values="1;.35;1" dur="2.5s" repeatCount="indefinite"/></circle>
          <text x="330" y="405" text-anchor="middle" fill="rgba(50,55,60,.8)" font-size="10.5" font-family="Google Sans,system-ui,sans-serif">Planner</text>
        </svg>
      </div><!-- /.bn-net -->

      <!-- ② ACTIVE TASKS — 1×1 -->
      <div class="bento-card bn-task">
        <div class="b-pad">
          <div class="b-eye">Active Tasks</div>
          <div class="b-num" id="bn-task-n">12</div>
          <div class="b-sub" style="margin-bottom:20px;color:var(--fg3)">running right now</div>
          <div class="b-trow">
            <div class="b-tdot" style="background:var(--viz-blue)"></div>
            <div class="b-tlbl">Inference</div>
            <div class="b-tbar"><div class="b-tfil" style="width:80%;background:linear-gradient(90deg,var(--viz-blue),var(--viz-cyan))"></div></div>
            <div class="b-tcnt">5</div>
          </div>
          <div class="b-trow">
            <div class="b-tdot" style="background:var(--viz-green)"></div>
            <div class="b-tlbl">Tool calls</div>
            <div class="b-tbar"><div class="b-tfil" style="width:55%;background:var(--viz-green)"></div></div>
            <div class="b-tcnt">4</div>
          </div>
          <div class="b-trow">
            <div class="b-tdot" style="background:#febc2e"></div>
            <div class="b-tlbl">Retrieval</div>
            <div class="b-tbar"><div class="b-tfil" style="width:40%;background:#febc2e"></div></div>
            <div class="b-tcnt">3</div>
          </div>
          <div style="margin-top:auto;padding-top:18px;display:flex;align-items:center;gap:8px">
            <span style="width:6px;height:6px;border-radius:50%;background:#16a34a;box-shadow:0 0 8px rgba(22,163,74,.4);animation:pulse 1.4s ease-out infinite"></span>
            <span style="font-size:11px;color:var(--fg3);letter-spacing:-.005em">All systems nominal</span>
          </div>
        </div>
      </div>

      <!-- ③ LATENCY — 1×1 -->
      <div class="bento-card bn-lat">
        <div class="b-pad">
          <div class="b-eye">p50 Latency</div>
          <div id="bn-lat-n" style="font-family:var(--display);font-size:56px;font-weight:800;letter-spacing:-.04em;line-height:1;color:#0891b2">38<span style="font-size:24px;opacity:.55;margin-left:3px">ms</span></div>
          <div class="b-sub" style="color:rgba(8,145,178,.65)">last 60 seconds</div>
          <div style="margin-top:auto">
            <svg width="100%" height="46" viewBox="0 0 220 46" preserveAspectRatio="none">
              <defs>
                <linearGradient id="bn-sp-g" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="rgba(8,145,178,.18)"/>
                  <stop offset="100%" stop-color="rgba(0,212,232,0)"/>
                </linearGradient>
              </defs>
              <polygon id="bn-sp-fill" points="0,40 20,34 40,36 60,26 80,30 100,22 120,28 140,20 160,25 180,15 200,19 220,17 220,46 0,46" fill="url(#bn-sp-g)"/>
              <polyline id="bn-sp-line" points="0,40 20,34 40,36 60,26 80,30 100,22 120,28 140,20 160,25 180,15 200,19 220,17" fill="none" stroke="#0891b2" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- ④ AGENTS ONLINE — 1×1 small -->
      <div class="bento-card bn-ag">
        <div class="b-mid">
          <div class="b-eye" style="margin-bottom:2px">Agents Online</div>
          <div style="display:flex;align-items:center;gap:14px">
            <div style="font-family:var(--display);font-size:44px;font-weight:800;letter-spacing:-.04em;color:var(--fg1);line-height:1">5<span style="font-size:20px;color:var(--fg3);font-weight:400">/5</span></div>
            <div style="display:flex;gap:7px;align-items:center;flex-wrap:wrap">
              <div style="width:10px;height:10px;border-radius:50%;background:#16a34a;box-shadow:0 0 8px rgba(22,163,74,.4)"></div>
              <div style="width:10px;height:10px;border-radius:50%;background:#16a34a;box-shadow:0 0 8px rgba(22,163,74,.4)"></div>
              <div style="width:10px;height:10px;border-radius:50%;background:#d97706;box-shadow:0 0 8px rgba(217,119,6,.4)"></div>
              <div style="width:10px;height:10px;border-radius:50%;background:#16a34a;box-shadow:0 0 8px rgba(22,163,74,.4)"></div>
              <div style="width:10px;height:10px;border-radius:50%;background:#16a34a;box-shadow:0 0 8px rgba(22,163,74,.4)"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ⑤ SUCCESS RATE — 1×1 small -->
      <div class="bento-card bn-rate">
        <div class="b-mid">
          <div class="b-eye" style="margin-bottom:2px">Eval Pass Rate</div>
          <div style="font-family:var(--display);font-size:44px;font-weight:800;letter-spacing:-.04em;color:#16a34a;line-height:1">98.7<span style="font-size:22px;opacity:.55;margin-left:1px">%</span></div>
        </div>
      </div>

      <!-- ⑥ MEMORY & CONTEXT — 1×1 -->
      <div class="bento-card bn-mem">
        <div class="b-pad">
          <div class="b-eye">Memory &amp; Context</div>
          <div style="display:flex;align-items:center;gap:16px;margin-bottom:14px">
            <div class="mem-ring">
              <svg viewBox="0 0 72 72" width="72" height="72">
                <defs>
                  <linearGradient id="mem-g" x1="1" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--accent)"/>
                    <stop offset="100%" stop-color="#0891b2"/>
                  </linearGradient>
                </defs>
                <circle cx="36" cy="36" r="28" fill="none" stroke="rgba(0,0,0,.07)" stroke-width="5.5"/>
                <circle cx="36" cy="36" r="28" fill="none" stroke="url(#mem-g)" stroke-width="5.5" stroke-linecap="round" stroke-dasharray="175.9" stroke-dashoffset="38.7"/>
              </svg>
              <div class="mem-ring-lbl" style="color:var(--fg1)">78%</div>
            </div>
            <div style="flex:1">
              <div style="font-size:11px;color:var(--fg3);margin-bottom:5px;letter-spacing:-.005em">Context window used</div>
              <div style="height:4px;background:var(--border-strong);border-radius:2px;margin-bottom:12px;overflow:hidden"><div style="height:100%;width:78%;background:linear-gradient(90deg,var(--viz-blue),var(--viz-cyan));border-radius:2px"></div></div>
              <div class="mem-stat"><span class="mem-s-l">Chunks retrieved</span><span class="mem-s-v">2,441</span></div>
              <div class="mem-stat"><span class="mem-s-l">Vector store</span><span class="mem-s-v">2.4M</span></div>
              <div class="mem-stat"><span class="mem-s-l">Cache hit rate</span><span class="mem-s-v">94.2%</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ⑦ LIVE AGENT LOG — 2×1 -->
      <div class="bento-card bn-log">
        <div class="b-pad">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
            <div class="b-eye" style="margin-bottom:0">Live Agent Log</div>
            <div style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--fg3)">
              <span style="width:6px;height:6px;border-radius:50%;background:#16a34a;box-shadow:0 0 7px rgba(22,163,74,.5);animation:pulse 1.4s ease-out infinite"></span>
              streaming
            </div>
          </div>
          <div style="position:relative;flex:1;overflow:hidden">
            <div id="bn-log-stream" style="display:flex;flex-direction:column;gap:3px"></div>
            <div style="position:absolute;bottom:0;left:0;right:0;height:44px;background:linear-gradient(transparent,#f6f8fc);pointer-events:none"></div>
          </div>
        </div>
      </div>

      <!-- ⑧ HUMAN-IN-LOOP — 1×1 -->
      <div class="bento-card bn-hil">
        <div class="b-pad">
          <div class="hil-badge">
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M6 1v5m0 2.5v.5" stroke="#febc2e" stroke-width="1.8" stroke-linecap="round"/></svg>
            Approval needed
          </div>
          <div class="hil-title" style="color:var(--fg1)">Send Q2 report to 12 enterprise clients</div>
          <div class="hil-body">Writer Agent has prepared the final draft. Human sign-off required before external distribution.</div>
          <div class="hil-btns">
            <button class="hil-btn hil-ok" data-hil-approve type="button">✓ Approve</button>
            <button class="hil-btn hil-no" type="button">Reject</button>
          </div>
        </div>
      </div>

    </div><!-- /.bento-grid -->
  </div><!-- /.wrap -->
</section>

<script>
  const section = document.querySelector<HTMLElement>('.bento-section');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Approve button — mirrors the prototype's inline handler
  document.querySelectorAll<HTMLElement>('[data-hil-approve]').forEach((btn) => {
    btn.addEventListener('click', () => btn.closest('.bn-hil')?.classList.add('approved'));
  });

  // ── Live agent log stream (returns its tick fn; caller controls the timer) ──
  const logTick = (function () {
    const stream = document.getElementById('bn-log-stream');
    if (!stream) return null;
    const A = [
      { n: 'ORCH',     c: '#1a73e8', b: 'rgba(26,115,232,.10)' },
      { n: 'RESEARCH', c: '#0891b2', b: 'rgba(8,145,178,.10)' },
      { n: 'CODE',     c: '#2563eb', b: 'rgba(37,99,235,.09)' },
      { n: 'WRITER',   c: '#16a34a', b: 'rgba(22,163,74,.10)' },
      { n: 'QA',       c: '#b45309', b: 'rgba(180,83,9,.10)' },
      { n: 'PLANNER',  c: '#6366f1', b: 'rgba(99,102,241,.10)' },
    ];
    const M: [string, string][] = [
      ['ORCH', 'Planning: generate Q2 revenue report for enterprise clients'],
      ['RESEARCH', 'Querying vector store · 2,441 relevant chunks retrieved'],
      ['CODE', 'fetch_data(source="azure-sql", table="revenue_2026") → 200'],
      ['ORCH', 'Routing structured data → Writer Agent'],
      ['WRITER', 'Drafting executive summary · 420 words written'],
      ['CODE', 'Running pandas analysis · DataFrame[rows=14,823] loaded'],
      ['RESEARCH', 'Web search: "Q2 2026 SaaS industry benchmarks" · 8 hits'],
      ['WRITER', 'Section 2 complete · chart assets generated'],
      ['QA', 'Fact-checking section 1–3 · cross-referencing sources'],
      ['CODE', 'Exporting 4 charts to PDF · matplotlib render complete'],
      ['QA', '✓ Verified · 0 hallucinations · all citations confirmed'],
      ['WRITER', 'Report finalised · 1,240 words · 4 charts · ready'],
      ['ORCH', 'Routing to human approval gate · awaiting sign-off'],
      ['PLANNER', 'Next task queued: client feedback collection · T+7d'],
      ['RESEARCH', 'Indexing new docs · 14 PDFs → 3,218 new chunks added'],
      ['CODE', 'Tool call: send_email(recipients=12) → pending approval'],
    ];
    const am: Record<string, { n: string; c: string; b: string }> = {};
    A.forEach((a) => { am[a.n] = a; });
    let idx = 0;
    const MAX = 10;
    function ts() {
      const d = new Date();
      return [d.getHours(), d.getMinutes(), d.getSeconds()].map((n) => String(n).padStart(2, '0')).join(':');
    }
    function addLine() {
      const [name, msg] = M[idx % M.length]; idx++;
      const ag = am[name];
      const el = document.createElement('div');
      el.className = 'log-line';
      el.innerHTML = '<span class="log-agent" style="color:' + ag.c + ';background:' + ag.b + '">' + name + '</span><span class="log-msg">' + msg + '</span><span class="log-ts">' + ts() + '</span>';
      el.style.cssText = 'opacity:0;transform:translateY(5px);transition:opacity .35s,transform .35s';
      stream!.appendChild(el);
      requestAnimationFrame(() => requestAnimationFrame(() => { el.style.opacity = '1'; el.style.transform = 'none'; }));
      // Trim one stale line per add. NOTE: removal is deferred (fade-out), so the
      // child stays in the DOM ~320ms — a `while` here would spin forever because
      // children.length never drops inside the loop. `if` + immediate detach guard
      // keeps it bounded. We mark it removed synchronously via a flag to avoid
      // re-selecting the same node on the next tick.
      if (stream!.children.length > MAX) {
        const old = stream!.firstElementChild as HTMLElement | null;
        if (old && !old.dataset.removing) {
          old.dataset.removing = '1';
          old.style.cssText += ';opacity:0;max-height:0;overflow:hidden;padding:0;margin:0;transition:opacity .25s,max-height .3s,margin .25s';
          setTimeout(() => old.remove(), 320);
        }
      }
    }
    for (let i = 0; i < 8; i++) addLine();   // seed with static content
    return addLine;
  })();

  // ── Latency sparkline (returns its tick fn) ──
  const spTick = (function () {
    const ln = document.getElementById('bn-sp-line');
    const fl = document.getElementById('bn-sp-fill');
    const nm = document.getElementById('bn-lat-n');
    if (!ln || !fl || !nm) return null;
    let v = [40, 34, 36, 26, 30, 22, 28, 20, 25, 15, 19, 17];
    function upd() {
      const nv = Math.max(8, Math.min(58, v[v.length - 1] + (Math.random() - .46) * 9));
      v.push(nv); v.shift();
      const W = 220, H = 46, mn = Math.min(...v), mx = Math.max(...v), r = mx - mn || 1;
      const pts = v.map((val, i) => ((i / (v.length - 1)) * W).toFixed(1) + ',' + (H - 4 - ((val - mn) / r) * (H - 14)).toFixed(1)).join(' ');
      ln!.setAttribute('points', pts);
      fl!.setAttribute('points', pts + ' ' + W + ',' + H + ' 0,' + H);
      const avg = Math.round(v.reduce((a, b) => a + b, 0) / v.length);
      nm!.innerHTML = avg + '<span style="font-size:24px;opacity:.55;margin-left:3px">ms</span>';
    }
    return upd;
  })();

  // ── Visibility-gated animation control ──
  // SMIL (the network SVG) and the two timers only run while the section is on
  // screen; everything freezes when scrolled away or under reduced-motion.
  // Only the JS timers are gated here. Off-screen *rendering* (incl. SMIL paint)
  // is skipped natively via `content-visibility:auto` on .bento-section — no
  // SVG pauseAnimations() (that API can crash the renderer on heavy SMIL trees).
  let logTimer = 0, spTimer = 0, running = false;
  function start() {
    if (running || reduce) return;
    running = true;
    section?.classList.remove('bn-paused');
    if (logTick) logTimer = window.setInterval(logTick, 1850);
    if (spTick) spTimer = window.setInterval(spTick, 2200);
  }
  function stop() {
    running = false;
    section?.classList.add('bn-paused');
    clearInterval(logTimer);
    clearInterval(spTimer);
  }

  if (reduce) {
    section?.classList.add('bn-paused');
  } else if (section && !section.dataset.bnInit) {
    section.dataset.bnInit = '1'; // guard against HMR re-running this script
    stop(); // begin idle; the observer starts the timers when visible
    new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? start() : stop()));
    }, { rootMargin: '120px' }).observe(section);
  }
</script>
