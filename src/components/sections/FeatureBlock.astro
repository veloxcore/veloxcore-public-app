---
import CodePanel from './CodePanel.astro';
---
<section data-screen-label="03 Pipeline">
  <div class="feature">
    <div class="feature-grid">
      <div class="reveal">
        <span class="sec-eyebrow">Pipeline</span>
        <h2>Built for the agent-first era</h2>
        <p>From Stream Analytics to Cortana Analytics, deploy ML pipelines that respond in milliseconds, not minutes. Schema-aware, version-controlled, observable end-to-end.</p>
        <a class="btn-dark-pill" href="/services">See architecture →</a>
        <div class="feature-stats">
          <div><div class="stat-num" style="-webkit-text-fill-color:var(--dark-fg1);color:var(--dark-fg1)">99.97%</div><div class="stat-label">uptime · 12-month rolling</div></div>
          <div><div class="stat-num" style="-webkit-text-fill-color:var(--dark-fg1);color:var(--dark-fg1)">42ms</div><div class="stat-label">p50 stream latency</div></div>
          <div><div class="stat-num" style="-webkit-text-fill-color:var(--dark-fg1);color:var(--dark-fg1)">6×</div><div class="stat-label">faster than prior batch</div></div>
        </div>
      </div>
      <CodePanel />
    </div>
  </div>
</section>
