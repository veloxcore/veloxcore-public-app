---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map(s => ({ params: { slug: s.slug }, props: { study: s } }));
}

const { study } = Astro.props;
const { Content } = await study.render();
const d = study.data;

const ICONS: Record<string, string> = {
  waveform:    `<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>`,
  monitor:     `<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>`,
  database:    `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3S3 13.66 3 12"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>`,
  synapse:     `<path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/>`,
  'bar-chart': `<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>`,
  lock:        `<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>`,
  cpu:         `<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>`,
  layers:      `<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>`,
  cloud:       `<path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/>`,
  activity:    `<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>`,
};

const coverStyle = d.heroGradient
  ? `background:${d.heroGradient}`
  : `background:var(--dark-surface)`;
---
<BaseLayout title={`${d.title} — Veloxcore`} description={d.excerpt}>

<div class="cs-hero">
  <div class="cs-hero-cover" style={coverStyle}>
    <div class="hero-label">
      <div class="hero-breadcrumb">
        <a href="/work">Work</a>
        <span class="sep">›</span>
        <span>{d.client}</span>
      </div>
    </div>
  </div>
</div>

{d.meta && (
  <div class="meta-strip">
    <div class="wrap">
      <div class="meta-inner">
        <div class="meta-item"><div class="meta-label">Client</div><div class="meta-value">{d.meta.client}</div></div>
        <div class="meta-item"><div class="meta-label">Industry</div><div class="meta-value">{d.meta.industry}</div></div>
        <div class="meta-item"><div class="meta-label">Engagement</div><div class="meta-value">{d.meta.engagement}</div></div>
        <div class="meta-item"><div class="meta-label">Delivered</div><div class="meta-value">{d.meta.delivered}</div></div>
        <div class="meta-item"><div class="meta-label">Region</div><div class="meta-value">{d.meta.region}</div></div>
        {d.tags.length > 0 && (
          <div class="meta-tags">
            {d.tags.map(t => <span class={`tag ${t.cls}`}>{t.label}</span>)}
          </div>
        )}
      </div>
    </div>
  </div>
)}

<div class="article-wrap">
  <div class="article-grid">
    <article class="prose">
      <Content />
    </article>

    <aside class="article-sidebar">
      {d.sidebarOutcomes.length > 0 && (
        <div class="sidebar-card">
          <div class="sidebar-card-title">Key outcomes</div>
          <div class="sidebar-outcome">
            {d.sidebarOutcomes.map(o => (
              <div class="s-out">
                <div class="s-out-num">{o.num}</div>
                <div class="s-out-label">{o.label}</div>
              </div>
            ))}
          </div>
        </div>
      )}

      {d.techStack.length > 0 && (
        <div class="sidebar-card">
          <div class="sidebar-card-title">Tech stack</div>
          <div class="tech-stack">
            {d.techStack.map(t => (
              <div class="tech-item">
                <div class="tech-ico" style={`background:${t.iconBg};color:${t.iconColor}`}>
                  <svg viewBox="0 0 24 24" set:html={ICONS[t.icon] ?? ''} />
                </div>
                {t.name}
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="sidebar-cta">
        <div class="sidebar-cta-h">Got a similar challenge?</div>
        <div class="sidebar-cta-sub">Book a free 45-minute architecture review. No sales pitch.</div>
        <a class="sidebar-cta-btn" href="/contact">Book a free call</a>
      </div>
    </aside>
  </div>
</div>

{d.related.length > 0 && (
  <section class="related">
    <div class="wrap">
      <div class="related-h">More case studies</div>
      <div class="related-grid">
        {d.related.map(r => (
          <a class="related-card" href={`/work/${r.slug}`}>
            <div class="related-thumb" style={r.thumbStyle}></div>
            <div class="related-body">
              <div class="related-cat">{r.category}</div>
              <div class="related-title">{r.title}</div>
            </div>
          </a>
        ))}
      </div>
      <div class="related-all"><a href="/work">View all case studies →</a></div>
    </div>
  </section>
)}

<script>
(function(){
  const els = Array.from(document.querySelectorAll('.reveal'));
  function check(){
    const vh = window.innerHeight;
    els.forEach(el => {
      if(el.classList.contains('visible')) return;
      const r = el.getBoundingClientRect();
      if(r.top < vh * .93 && r.bottom > 0) el.classList.add('visible');
    });
  }
  window.addEventListener('scroll', check, {passive:true});
  window.addEventListener('resize', check);
  setTimeout(check, 80);
})();
</script>

</BaseLayout>
