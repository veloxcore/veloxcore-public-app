---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostDefault from '../../components/blog/PostDefault.astro';
import PostBroadsheet from '../../components/blog/PostBroadsheet.astro';
import PostCinematic from '../../components/blog/PostCinematic.astro';
import PostSidebar from '../../components/blog/PostSidebar.astro';
import PostTypographic from '../../components/blog/PostTypographic.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter(p => !p.data.draft).map(p => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const tpl = post.data.template ?? 'default';
---
<BaseLayout title={`${post.data.title} — Veloxcore Blog`} description={post.data.excerpt}>
  {tpl === 'broadsheet'   && <PostBroadsheet   post={post} />}
  {tpl === 'cinematic'    && <PostCinematic    post={post} />}
  {tpl === 'sidebar'      && <PostSidebar      post={post} />}
  {tpl === 'typographic'  && <PostTypographic  post={post} />}
  {tpl === 'default'      && <PostDefault      post={post} />}
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.getAttribute('aria-label') === 'Copy link') {
        navigator.clipboard.writeText(window.location.href).catch(() => {});
      }
    });
  });
</script>
