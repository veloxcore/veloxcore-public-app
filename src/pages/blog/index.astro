---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const TAG_MAP: Record<string, { cls: string; darkCls: string; slug: string }> = {
  'AI':              { cls: 'tag-ai',      darkCls: 'tag-d-ai',      slug: 'ai'      },
  'LLM':             { cls: 'tag-ai',      darkCls: 'tag-d-ai',      slug: 'llm'     },
  'Agents':          { cls: 'tag-ai',      darkCls: 'tag-d-ai',      slug: 'agents'  },
  'RAG':             { cls: 'tag-ai',      darkCls: 'tag-d-ai',      slug: 'rag'     },
  'Big Data':        { cls: 'tag-bigdata', darkCls: 'tag-d-bigdata', slug: 'bigdata' },
  'Azure':           { cls: 'tag-azure',   darkCls: 'tag-d-azure',   slug: 'azure'   },
  'Machine Learning':{ cls: 'tag-ml',      darkCls: 'tag-d-ml',      slug: 'ml'      },
  'IoT':             { cls: 'tag-iot',      darkCls: 'tag-d-iot',     slug: 'iot'     },
  '.NET':            { cls: 'tag-dotnet',  darkCls: 'tag-d-dotnet',  slug: 'dotnet'  },
  'Architecture':    { cls: 'tag-arch',    darkCls: 'tag-d-arch',    slug: 'arch'    },
};
const tagOf = (t: string) => TAG_MAP[t] ?? { cls: 'tag-azure', darkCls: 'tag-d-azure', slug: t.toLowerCase() };

const hero = posts[0];
const rest  = posts.slice(1);

const cats = [...new Set(posts.map(p => tagOf(p.data.tag).slug))];
---
<BaseLayout title="Blog — Veloxcore" description="Deep dives from the Veloxcore team on production AI, LLMs, agents, RAG, and the Azure infrastructure behind it all.">

  <!-- PAGE HEADER -->
  <header class="blog-page-header">
    <canvas class="blog-hero-canvas" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="blog-page-eyebrow">From the blog</div>
      <h1>Ideas on AI,<br>cloud &amp; engineering.</h1>
      <p>Deep dives from the Veloxcore team on production AI, LLMs, agents, RAG, and the Azure infrastructure behind it all.</p>
      <div class="filter-bar" id="filter-bar">
        <button class="filter-pill active" data-filter="all">All posts</button>
        {cats.map(slug => (
          <button class="filter-pill" data-filter={slug}>
            {posts.find(p => tagOf(p.data.tag).slug === slug)?.data.tag}
          </button>
        ))}
      </div>
    </div>
  </header>

  <!-- EDITORIAL HERO -->
  <section class="blog-section">
    <div class="wrap">
      <div class="section-row">
        <span class="section-eyebrow">Editor's pick</span>
      </div>
      <a class="hero-post reveal" href={`/blog/${hero.slug}`} data-cat={tagOf(hero.data.tag).slug}>
        <div class="hero-cover"
          style={hero.data.coverImage
            ? `background-image:url(${hero.data.coverImage});background-size:cover;background-position:center`
            : undefined}>
        </div>
        <div class="hero-body">
          <span class={`tag ${tagOf(hero.data.tag).darkCls}`}>{hero.data.tag}</span>
          <h2>{hero.data.title}</h2>
          {hero.data.excerpt && <p class="excerpt">{hero.data.excerpt}</p>}
          <div class="hero-meta">
            <div style="display:flex;align-items:center;gap:8px">
              <div class="hero-avatar">{(() => { const p = (hero.data.author ?? '').split(' '); return (p[0]?.[0] ?? '') + (p[1]?.[0] ?? ''); })()}</div>
              <span>{hero.data.author}</span>
            </div>
            <span>·</span>
            <span>{fmt(hero.data.date)}</span>
            {hero.data.readTime && <><span>·</span><span>{hero.data.readTime} read</span></>}
          </div>
          <span class="hero-read">
            Read article
            <span class="hero-arrow">
              <svg viewBox="0 0 13 13"><line x1="2" y1="11" x2="11" y2="2"/><polyline points="5 2 11 2 11 8"/></svg>
            </span>
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- CARD GRID -->
  {rest.length > 0 && (
    <section class="blog-section">
      <div class="wrap">
        <div class="section-row">
          <span class="section-eyebrow">Latest</span>
        </div>
        <div class="bl-card-grid">
          {rest.map((p, i) => (
            <a class="bl-card reveal"
               style={`transition-delay:${i * 0.07}s`}
               href={`/blog/${p.slug}`}
               data-cat={tagOf(p.data.tag).slug}>
              <div class={`bl-card-cover`}
                style={p.data.coverImage
                  ? `background-image:url(${p.data.coverImage});background-size:cover;background-position:center`
                  : undefined}>
              </div>
              <div class="bl-card-body">
                <span class={`tag ${tagOf(p.data.tag).cls}`}>{p.data.tag}</span>
                <h3 class="bl-card-title">{p.data.title}</h3>
                {p.data.excerpt && <p class="bl-card-excerpt">{p.data.excerpt}</p>}
                <div class="bl-card-foot">
                  <span>{p.data.author}</span>
                  <span class="dot-sep"></span>
                  <span>{fmt(p.data.date)}</span>
                  {p.data.readTime && <><span class="dot-sep"></span><span>{p.data.readTime}</span></>}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<script>
(function () {
  // ── canvas particle field (same as services) ──────────
  const canvas = document.querySelector('.blog-hero-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const pts: { x: number; y: number; vx: number; vy: number; r: number; a: number }[] = [];
    function resize() {
      canvas.width  = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    }
    function init() {
      pts.length = 0;
      for (let i = 0; i < 80; i++) {
        pts.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - .5) * .28,
          vy: (Math.random() - .5) * .28,
          r: Math.random() * 1.4 + .4,
          a: Math.random(),
        });
      }
    }
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const p of pts) {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width) p.x = 0;
        if (p.y < 0) p.y = canvas.height;
        if (p.y > canvas.height) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(173,198,255,${p.a * .55})`;
        ctx.fill();
      }
      requestAnimationFrame(draw);
    }
    resize(); init(); draw();
    window.addEventListener('resize', () => { resize(); init(); });
  }

  // ── filter pills ──────────────────────────────────────
  const bar = document.getElementById('filter-bar');
  if (bar) {
    bar.addEventListener('click', e => {
      const pill = (e.target as Element).closest('.filter-pill') as HTMLElement | null;
      if (!pill) return;
      bar.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      const cat = pill.dataset.filter ?? 'all';
      document.querySelectorAll<HTMLElement>('[data-cat]').forEach(el => {
        el.classList.toggle('bl-hidden', cat !== 'all' && el.dataset.cat !== cat);
      });
    });
  }
})();
</script>
