---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const TAG_MAP: Record<string, { slug: string }> = {
  'AI':              { slug: 'ai'      },
  'LLM':             { slug: 'ai'      },
  'Agents':          { slug: 'agents'  },
  'AI Agents':       { slug: 'agents'  },
  'RAG':             { slug: 'agents'  },
  'Big Data':        { slug: 'bigdata' },
  'Azure':           { slug: 'azure'   },
  'Machine Learning':{ slug: 'ml'      },
  'IoT':             { slug: 'iot'     },
  '.NET':            { slug: 'dotnet'  },
  'Architecture':    { slug: 'arch'    },
};
const slugOf = (t: string) => (TAG_MAP[t] ?? { slug: t.toLowerCase().replace(/\s+/g, '-') }).slug;

const hero = posts[0];

// Distinct categories, in first-seen order, for the filter rail.
const cats: { slug: string; label: string }[] = [];
for (const p of posts) {
  const slug = slugOf(p.data.tag);
  if (!cats.find(c => c.slug === slug)) cats.push({ slug, label: p.data.tag });
}

const initials = (name: string) => {
  const parts = (name ?? '').trim().split(/\s+/);
  return (parts[0]?.[0] ?? '') + (parts[1]?.[0] ?? '');
};
---
<BaseLayout
  title="Blog — Veloxcore"
  description="Deep dives from the Veloxcore team on production AI, LLMs, agents, RAG, and the Azure infrastructure behind it all.">

  <!-- ── MASTHEAD ─────────────────────────────────────────── -->
  <header class="bl-masthead">
    <div class="wrap">
      <div class="bl-mast-row">
        <div class="bl-mast-main">
          <div class="bl-eyebrow"><span class="bl-eyebrow-dot"></span>Veloxcore Engineering</div>
          <h1>Ideas on AI,<br>cloud &amp; engineering.</h1>
          <p>Deep dives from the team on production AI, LLMs, agents, RAG, and the Azure infrastructure behind it all. Written by the engineers who ship it.</p>
        </div>
        <div class="bl-mast-meta" aria-hidden="true">
          <span>PROD&nbsp;AI</span>
          <span>SHIPPED</span>
          <span>ON&nbsp;AZURE</span>
        </div>
      </div>
    </div>
  </header>

  {hero && (
    <!-- ── FEATURED ───────────────────────────────────────── -->
    <section class="bl-featured-sec">
      <div class="wrap">
        <div class="bl-sec-head"><span class="bl-sec-label">Editor's pick</span></div>
        <a class="bl-featured" href={`/blog/${hero.slug}`} data-cat={slugOf(hero.data.tag)}>
          <div class={`bl-featured-cover ${hero.data.coverImage ? '' : 'cov-aurora'}`}
               style={hero.data.coverImage
                 ? `background-image:url(${hero.data.coverImage})`
                 : undefined}>
            <span class="bl-cover-cat">{hero.data.tag}</span>
          </div>
          <div class="bl-featured-body">
            <h2>{hero.data.title}</h2>
            {hero.data.excerpt && <p class="bl-featured-excerpt">{hero.data.excerpt}</p>}
            <div class="bl-featured-meta">
              <span class="bl-avatar">{initials(hero.data.author)}</span>
              <span>{hero.data.author}</span>
              <span class="bl-dot"></span>
              <span>{fmt(hero.data.date)}</span>
              {hero.data.readTime && <><span class="bl-dot"></span><span>{hero.data.readTime} read</span></>}
            </div>
            <span class="bl-read">
              Read article
              <svg viewBox="0 0 13 13" aria-hidden="true"><line x1="2" y1="11" x2="11" y2="2"/><polyline points="5 2 11 2 11 8"/></svg>
            </span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ── INDEX: filter rail + article list ──────────────────── -->
  <section class="bl-index-sec">
    <div class="wrap">
      <div class="bl-index-grid">

        <aside class="bl-rail">
          <div class="bl-rail-label">Browse</div>
          <nav class="bl-filters" id="filter-bar">
            <button class="bl-filter active" data-filter="all">
              All articles<span class="bl-filter-n">{posts.length}</span>
            </button>
            {cats.map(c => (
              <button class="bl-filter" data-filter={c.slug}>
                {c.label}<span class="bl-filter-n">{posts.filter(p => slugOf(p.data.tag) === c.slug).length}</span>
              </button>
            ))}
          </nav>
          <div class="bl-rail-sub">
            <div class="bl-rail-sub-label">Subscribe</div>
            <p>New engineering write-ups, roughly monthly. No marketing.</p>
            <a class="bl-rail-cta" href="/contact">
              Get updates
              <svg viewBox="0 0 13 13" aria-hidden="true"><line x1="2" y1="11" x2="11" y2="2"/><polyline points="5 2 11 2 11 8"/></svg>
            </a>
          </div>
        </aside>

        <div class="bl-list">
          <div class="bl-sec-head"><span class="bl-sec-label">All articles</span></div>
          <div id="post-list">
            {posts.map(p => (
              <a class="bl-row" href={`/blog/${p.slug}`} data-cat={slugOf(p.data.tag)}>
                <span class="bl-row-date">{fmt(p.data.date)}</span>
                <span class="bl-row-cat">{p.data.tag}</span>
                <span class="bl-row-main">
                  <span class="bl-row-title">{p.data.title}</span>
                  {p.data.excerpt && <span class="bl-row-excerpt">{p.data.excerpt}</span>}
                </span>
                <span class="bl-row-read">{p.data.readTime ?? ''}</span>
                <svg class="bl-row-arrow" viewBox="0 0 13 13" aria-hidden="true"><line x1="2" y1="11" x2="11" y2="2"/><polyline points="5 2 11 2 11 8"/></svg>
              </a>
            ))}
          </div>
          <p class="bl-empty" id="bl-empty" hidden>No articles in this category yet.</p>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
(function () {
  const bar = document.getElementById('filter-bar');
  const empty = document.getElementById('bl-empty');
  if (!bar) return;

  bar.addEventListener('click', e => {
    const pill = (e.target as Element).closest('.bl-filter') as HTMLElement | null;
    if (!pill) return;
    bar.querySelectorAll('.bl-filter').forEach(p => p.classList.remove('active'));
    pill.classList.add('active');
    const cat = pill.dataset.filter ?? 'all';

    let visible = 0;
    document.querySelectorAll<HTMLElement>('.bl-row[data-cat]').forEach(el => {
      const show = cat === 'all' || el.dataset.cat === cat;
      el.classList.toggle('bl-hidden', !show);
      if (show) visible++;
    });
    // Featured card hides when filtering to a category it doesn't belong to.
    document.querySelectorAll<HTMLElement>('.bl-featured[data-cat]').forEach(el => {
      el.classList.toggle('bl-hidden', cat !== 'all' && el.dataset.cat !== cat);
    });
    if (empty) empty.hidden = visible !== 0;
  });
})();
</script>
