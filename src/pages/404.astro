---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Page not found · Veloxcore" description="The page you're looking for doesn't exist. Find what you need from Veloxcore's AI engineering services.">

<section class="not-found">
  <div class="wrap">
    <div class="nf-inner">
      <div class="nf-code">404</div>
      <h1 class="nf-h1">Page not found.</h1>
      <p class="nf-sub">The page you're looking for doesn't exist or has moved. Here's where to go next.</p>
      <div class="nf-links">
        <a class="nf-card" href="/services/generative-ai">
          <div class="nf-card-label">Service</div>
          <div class="nf-card-title">Generative AI &amp; LLMs</div>
        </a>
        <a class="nf-card" href="/services/ai-agents">
          <div class="nf-card-label">Service</div>
          <div class="nf-card-title">AI Agents &amp; MCP</div>
        </a>
        <a class="nf-card" href="/services/rag">
          <div class="nf-card-label">Service</div>
          <div class="nf-card-title">RAG Systems</div>
        </a>
        <a class="nf-card" href="/work">
          <div class="nf-card-label">Portfolio</div>
          <div class="nf-card-title">Case studies</div>
        </a>
        <a class="nf-card" href="/blog">
          <div class="nf-card-label">Blog</div>
          <div class="nf-card-title">Engineering blog</div>
        </a>
        <a class="nf-card" href="/contact">
          <div class="nf-card-label">Talk to us</div>
          <div class="nf-card-title">Book a free call</div>
        </a>
      </div>
      <a class="nf-home" href="/">← Back to home</a>
    </div>
  </div>
</section>

<style>
.not-found {
  min-height: 80vh;
  display: flex;
  align-items: center;
  padding: 120px 0 80px;
}
.nf-inner {
  max-width: 680px;
}
.nf-code {
  font-size: clamp(80px, 12vw, 140px);
  font-weight: 800;
  line-height: 1;
  background: linear-gradient(135deg, #3d7eff, #00d4e8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16px;
}
.nf-h1 {
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 700;
  color: var(--dark-fg1, #f0f4ff);
  margin: 0 0 12px;
}
.nf-sub {
  font-size: 17px;
  color: var(--dark-fg3, #8899bb);
  margin: 0 0 48px;
  line-height: 1.6;
}
.nf-links {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 12px;
  margin-bottom: 40px;
}
.nf-card {
  display: block;
  padding: 16px 20px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 10px;
  background: rgba(255,255,255,.03);
  text-decoration: none;
  transition: border-color .2s, background .2s;
}
.nf-card:hover {
  border-color: rgba(61,126,255,.4);
  background: rgba(61,126,255,.06);
}
.nf-card-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: #3d7eff;
  margin-bottom: 4px;
}
.nf-card-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--dark-fg1, #f0f4ff);
}
.nf-home {
  font-size: 14px;
  color: var(--dark-fg3, #8899bb);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color .2s, border-color .2s;
}
.nf-home:hover {
  color: var(--dark-fg1, #f0f4ff);
  border-color: currentColor;
}
</style>

</BaseLayout>
