          </div>
        </div>
      </div>
    </div>

    <!-- Senior team -->
    <div class="team-grid reveal">
      <div class="team-card">
        <div class="team-ava" style="background:linear-gradient(135deg,#1a73e8,#00d4e8)"></div>
        <div>
          <div class="team-name">Parth Patel</div>
          <div class="team-role">Engineering Lead</div>
          <span class="team-dept" style="background:#e8f0fe;color:#1a73e8">Azure &amp; Data</span>
        </div>
      </div>
      <div class="team-card">
        <div class="team-ava" style="background:linear-gradient(135deg,#7c3aed,#a855f7)"></div>
        <div>
          <div class="team-name">Anju Yadav</div>
          <div class="team-role">Operations &amp; Delivery</div>
          <span class="team-dept" style="background:#f3e8ff;color:#7c3aed">Operations</span>
        </div>
      </div>
      <div class="team-card">
        <div class="team-ava" style="background:linear-gradient(135deg,#137333,#00dd6a)"></div>
        <div>
          <div class="team-name">Tushar Patel</div>
          <div class="team-role">Senior Engineer</div>
          <span class="team-dept" style="background:#e6f4ea;color:#137333">Data Engineering</span>
        </div>
      </div>
      <div class="team-card">
        <div class="team-ava" style="background:linear-gradient(135deg,#0f766e,#14b8a6)"></div>
        <div>
          <div class="team-name">Edris Chhawniwala</div>
          <div class="team-role">Senior Engineer</div>
