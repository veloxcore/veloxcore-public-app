        </div>
      </div>
      <div class="team-card" style="border-style:dashed;background:transparent;align-items:center;justify-content:center;text-align:center;cursor:pointer;">
        <div style="width:52px;height:52px;border-radius:50%;border:2px dashed var(--border-strong);display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--fg3)">+</div>
