            <div class="ai-card-name">Velox<span>hire.AI</span></div>
            <div class="live-pill"><div class="live-dot"></div>Live product</div>
          </div>
          <div class="ai-card-tagline">AI video interviews that hire 5× faster.</div>
          <div class="ai-metrics">
            <div class="ai-metric"><div class="ai-metric-num">5×</div><div class="ai-metric-label">Faster hiring</div></div>
            <div class="ai-metric"><div class="ai-metric-num">24/7</div><div class="ai-metric-label">AI interviewer</div></div>
            <div class="ai-metric"><div class="ai-metric-num">Agentic</div><div class="ai-metric-label">Built on Azure OpenAI</div></div>
