              <circle cx="40" cy="30" r="14" fill="#1a73e8" opacity=".5"/>
              <ellipse cx="40" cy="68" rx="22" ry="14" fill="#1a73e8" opacity=".3"/>
            </svg>
          </div>
        </div>
        <div class="founder-body">
          <div>
            <div class="founder-name">Vinit B Yadav</div>
            <div class="founder-role">Founder &amp; CEO</div>
            <div class="founder-bio">A decade-plus building scalable data and AI systems on Microsoft Azure. Founded Veloxcore in 2012 in Ahmedabad and, more recently, the agentic interview platform Veloxhire.AI. Speaker on AI agents and MCP — most recently at the 9th Dot Net Day Ahmedabad (July 2025) to 200+ engineers.</div>
            <div class="founder-expertise">
              <span class="exp-tag">AI Agents &amp; MCP</span>
              <span class="exp-tag">Azure Data &amp; AI</span>
              <span class="exp-tag">Product</span>
            </div>
          </div>
          <div class="founder-links">
            <a class="founder-link" href="https://www.linkedin.com/in/vinityadav/" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              LinkedIn
            </a>
            <a class="founder-link" href="https://veloxhire.ai" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Veloxhire.AI
