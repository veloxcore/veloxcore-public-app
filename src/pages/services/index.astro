---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Services — Veloxcore">

<!-- ── HERO ─────────────────────────────────────── -->
<section class="page-hero" data-screen-label="01 Hero">
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="wrap">
    <div class="si-hero-inner">
      <div>
        <div class="page-eyebrow">What we do</div>
        <h1 class="hero-h1">Data services that move at the speed of your business.</h1>
        <p class="hero-sub">From raw event streams to boardroom dashboards — Veloxcore delivers end-to-end data engineering, analytics, and ML on the Azure platform.</p>
        <div class="hero-acts">
          <a class="btn-dark btn-pill" href="/contact">Talk to an expert</a>
          <a class="btn-soft btn-pill" href="/work">View case studies</a>
        </div>
      </div>
      <div class="hero-stats reveal">
        <div class="h-stat">
          <div>
            <div class="h-stat-label">Active pipelines</div>
            <div class="h-stat-sub">Across all client tenants · live</div>
            <div class="h-stat-bar"><div class="h-stat-fill" style="width:73%;background:linear-gradient(90deg,#3d7eff,#00d4e8)"></div></div>
          </div>
          <div class="h-stat-num">2,400+</div>
        </div>
        <div class="h-stat">
          <div>
            <div class="h-stat-label">Data processed daily</div>
            <div class="h-stat-sub">Across 6 countries</div>
            <div class="h-stat-bar"><div class="h-stat-fill" style="width:88%;background:linear-gradient(90deg,#00dd6a,#00d4e8)"></div></div>
          </div>
          <div class="h-stat-num">140M+</div>
        </div>
        <div class="h-stat">
          <div>
            <div class="h-stat-label">Average cloud cost reduction</div>
            <div class="h-stat-sub">Post-engagement baseline</div>
            <div class="h-stat-bar"><div class="h-stat-fill" style="width:38%;background:linear-gradient(90deg,#7c3aed,#a855f7)"></div></div>
          </div>
          <div class="h-stat-num">38%</div>
        </div>
        <div class="h-stat">
          <div>
            <div class="h-stat-label">Uptime SLA</div>
            <div class="h-stat-sub">12-month rolling average</div>
            <div class="h-stat-bar"><div class="h-stat-fill" style="width:99.97%;background:linear-gradient(90deg,#8ce800,#00dd6a)"></div></div>
          </div>
          <div class="h-stat-num">99.97%</div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-strip">
    <div class="wrap">
      <div class="strip-inner">
        <div class="strip-item"><div class="strip-dot" style="background:#3d7eff"></div>Microsoft Gold Partner</div>
        <div class="strip-item"><div class="strip-dot" style="background:#00dd6a"></div>Azure Certified Engineers</div>
        <div class="strip-item"><div class="strip-dot" style="background:#febc2e"></div>ISO 27001 Aligned</div>
        <div class="strip-item"><div class="strip-dot" style="background:#a855f7"></div>GDPR Compliant</div>
        <div class="strip-item"><div class="strip-dot" style="background:#00d4e8"></div>6 Countries Served</div>
      </div>
    </div>
  </div>
</section>

<!-- ── SERVICE 01 — DATA ANALYTICS ──────────────── -->
<section class="service-section" data-screen-label="02 Data Analytics">
  <div class="wrap">
    <div class="svc-grid reveal">
      <div>
        <div class="svc-num">01</div>
        <h2 class="svc-h2">Data Analytics &amp; Engineering</h2>
        <p class="svc-desc">We design, build, and operate high-throughput data pipelines on Azure — from Event Hubs ingestion to HDInsight transformation to Power BI delivery. Every pipeline is observable, version-controlled, and SLA-backed.</p>
        <div class="svc-features">
          <div class="svc-feat">
            <div class="feat-check" style="background:#1a73e8"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Batch &amp; streaming unified.</strong> Tumbling windows, late-arrival handling, and exactly-once semantics — all in one topology.</div>
          </div>
          <div class="svc-feat">
            <div class="feat-check" style="background:#1a73e8"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Schema governance.</strong> Avro schema registries, contract testing, and automated migration across distributed teams.</div>
          </div>
          <div class="svc-feat">
            <div class="feat-check" style="background:#1a73e8"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Cost engineering.</strong> Right-sized clusters, spot VMs, and autoscaling heuristics — proven to reduce bills by 30–40%.</div>
          </div>
        </div>
        <a class="svc-link" href="/work">Read the case study <span class="svc-arrow"><svg viewBox="0 0 13 13"><line x1="2" y1="11" x2="11" y2="2"/><polyline points="5 2 11 2 11 8"/></svg></span></a>
      </div>
      <div class="svc-panel">
        <div class="panel-analytics">
          <div class="panel-label">Live Pipeline · Production</div>
          <div class="pipeline-row">
            <div class="pipe-step"><div class="pipe-step-label">Event Hubs</div><div class="pipe-step-val">140M/day</div></div>
            <div class="pipe-arr">→</div>
            <div class="pipe-step"><div class="pipe-step-label">Stream Analytics</div><div class="pipe-step-val">5-min window</div></div>
            <div class="pipe-arr">→</div>
            <div class="pipe-step"><div class="pipe-step-label">Data Factory</div><div class="pipe-step-val">32 pipelines</div></div>
          </div>
          <div class="spark-grid">
            <div class="spark-card">
              <div class="spark-card-top"><span class="spark-card-name">Throughput</span><div class="live-dot"></div></div>
              <div class="spark-card-val" style="color:#00dd6a">1.62M <span style="font-size:11px;color:var(--dark-fg3)">events/s</span></div>
              <div class="spark-bar-wrap"><div class="spark-bar" style="width:81%;background:linear-gradient(90deg,#3d7eff,#00d4e8)"></div></div>
            </div>
            <div class="spark-card">
              <div class="spark-card-top"><span class="spark-card-name">Latency p99</span><div class="live-dot"></div></div>
              <div class="spark-card-val">48 <span style="font-size:11px;color:var(--dark-fg3)">ms</span></div>
              <div class="spark-bar-wrap"><div class="spark-bar" style="width:22%;background:linear-gradient(90deg,#00dd6a,#8ce800)"></div></div>
            </div>
            <div class="spark-card">
              <div class="spark-card-top"><span class="spark-card-name">Uptime</span></div>
              <div class="spark-card-val" style="color:#00dd6a">99.97<span style="font-size:11px;color:var(--dark-fg3)">%</span></div>
              <div class="spark-bar-wrap"><div class="spark-bar" style="width:99.97%;background:linear-gradient(90deg,#8ce800,#00dd6a)"></div></div>
            </div>
            <div class="spark-card">
              <div class="spark-card-top"><span class="spark-card-name">Cost/GB</span></div>
              <div class="spark-card-val">$0.018</div>
              <div class="spark-bar-wrap"><div class="spark-bar" style="width:35%;background:linear-gradient(90deg,#a855f7,#7c3aed)"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── SERVICE 02 — VISUALISATION ───────────────── -->
<section class="service-section" data-screen-label="03 Visualisation">
  <div class="wrap">
    <div class="svc-grid flip reveal">
      <div>
        <div class="svc-num">02</div>
        <h2 class="svc-h2">Data Visualisation</h2>
        <p class="svc-desc">We turn complex data into decisions. Custom Power BI semantic models, embedded analytics, and executive dashboards that refresh on the minute — not the month.</p>
        <div class="svc-features">
          <div class="svc-feat">
            <div class="feat-check" style="background:#137333"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Power BI Premium.</strong> Paginated reports, large-model storage, and embedded analytics inside your own product.</div>
          </div>
          <div class="svc-feat">
            <div class="feat-check" style="background:#137333"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Semantic modelling.</strong> Star schemas, row-level security, and DAX that scales to billion-row fact tables.</div>
          </div>
          <div class="svc-feat">
            <div class="feat-check" style="background:#137333"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Real-time dashboards.</strong> DirectQuery and push datasets for sub-second refresh — no scheduled refresh required.</div>
          </div>
        </div>
        <a class="svc-link" href="/work">See the showcase <span class="svc-arrow"><svg viewBox="0 0 13 13"><line x1="2" y1="11" x2="11" y2="2"/><polyline points="5 2 11 2 11 8"/></svg></span></a>
      </div>
      <div class="svc-panel">
        <div class="panel-viz">
          <div class="chart-header">
            <div><div class="chart-title">Regional Sales Performance</div><div class="chart-sub">Last 6 months · All regions</div></div>
            <div class="chart-legend">
              <div class="leg-item"><div class="leg-dot" style="background:#1a73e8"></div>Actual</div>
              <div class="leg-item"><div class="leg-dot" style="background:#e8f0fe"></div>Target</div>
            </div>
          </div>
          <div class="chart-area">
            <div class="bar-group"><div class="bar-pair"><div class="bar-a" style="height:110px"></div><div class="bar-b" style="height:130px"></div></div><div class="bar-month">Jan</div></div>
            <div class="bar-group"><div class="bar-pair"><div class="bar-a" style="height:145px"></div><div class="bar-b" style="height:130px"></div></div><div class="bar-month">Feb</div></div>
            <div class="bar-group"><div class="bar-pair"><div class="bar-a" style="height:125px"></div><div class="bar-b" style="height:140px"></div></div><div class="bar-month">Mar</div></div>
            <div class="bar-group"><div class="bar-pair"><div class="bar-a" style="height:165px"></div><div class="bar-b" style="height:150px"></div></div><div class="bar-month">Apr</div></div>
            <div class="bar-group"><div class="bar-pair"><div class="bar-a" style="height:148px"></div><div class="bar-b" style="height:155px"></div></div><div class="bar-month">May</div></div>
            <div class="bar-group"><div class="bar-pair"><div class="bar-a" style="height:178px"></div><div class="bar-b" style="height:160px"></div></div><div class="bar-month">Jun</div></div>
          </div>
          <div class="chart-foot">
            <div class="chart-kpi"><div class="chart-kpi-num">₹ 3.2Cr</div><div class="chart-kpi-label">Total revenue · YTD</div></div>
            <div class="chart-kpi"><div class="chart-kpi-num">+18% <span class="chart-kpi-badge badge-up">↑ vs last year</span></div><div class="chart-kpi-label">Growth rate</div></div>
            <div class="chart-kpi"><div class="chart-kpi-num">6 regions</div><div class="chart-kpi-label">Active markets</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── SERVICE 03 — AZURE ARCHITECTURE ──────────── -->
<section class="service-section" data-screen-label="04 Architecture">
  <div class="wrap">
    <div class="svc-grid reveal">
      <div>
        <div class="svc-num">03</div>
        <h2 class="svc-h2">Azure Architecture &amp; Migration</h2>
        <p class="svc-desc">12-week migration playbooks. Zero-downtime cutovers. Dependency mapping, parallel-run validation, and the cutover checklists that have kept every client online — across 40+ enterprise migrations.</p>
        <div class="svc-features">
          <div class="svc-feat">
            <div class="feat-check" style="background:#c5221f"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Landing zone design.</strong> Hub-spoke networking, private endpoints, and Azure Policy guardrails from day one.</div>
          </div>
          <div class="svc-feat">
            <div class="feat-check" style="background:#c5221f"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Zero-downtime migrations.</strong> Parallel-run validation and traffic shifting — no maintenance windows.</div>
          </div>
          <div class="svc-feat">
            <div class="feat-check" style="background:#c5221f"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>FinOps from day one.</strong> Reserved instance analysis, auto-shutdown schedules, and a cost dashboard handed over at close.</div>
          </div>
        </div>
        <a class="svc-link" href="/services/azure-ai">Explore Azure AI &amp; Cloud <span class="svc-arrow"><svg viewBox="0 0 13 13"><line x1="2" y1="11" x2="11" y2="2"/><polyline points="5 2 11 2 11 8"/></svg></span></a>
      </div>
      <div class="svc-panel">
        <div class="panel-arch">
          <div class="panel-label">Azure Topology · Client Tenant</div>
          <div class="arch-nodes">
            <div class="arch-node">
              <div class="arch-node-ico" style="background:rgba(61,126,255,.15)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3d7eff" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div>
              <div class="arch-node-name">Hub VNet</div>
              <div class="arch-node-status"><div class="live-dot"></div>Active</div>
            </div>
            <div class="arch-node">
              <div class="arch-node-ico" style="background:rgba(0,212,232,.15)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00d4e8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
              <div class="arch-node-name">Event Hubs</div>
              <div class="arch-node-status"><div class="live-dot"></div>1.6M eps</div>
            </div>
            <div class="arch-node">
              <div class="arch-node-ico" style="background:rgba(140,232,0,.12)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8ce800" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3S3 13.66 3 12"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg></div>
              <div class="arch-node-name">Data Lake</div>
              <div class="arch-node-status"><div class="live-dot"></div>42TB</div>
            </div>
            <div class="arch-node">
              <div class="arch-node-ico" style="background:rgba(192,132,252,.15)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
              <div class="arch-node-name">ML Workspace</div>
              <div class="arch-node-status"><div class="live-dot"></div>4 models</div>
            </div>
            <div class="arch-node">
              <div class="arch-node-ico" style="background:rgba(173,198,255,.15)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#adc6ff" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
              <div class="arch-node-name">Key Vault</div>
              <div class="arch-node-status"><div class="live-dot"></div>Secured</div>
            </div>
            <div class="arch-node">
              <div class="arch-node-ico" style="background:rgba(255,120,80,.12)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff7850" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg></div>
              <div class="arch-node-name">Monitor</div>
              <div class="arch-node-status"><div class="live-dot"></div>All green</div>
            </div>
          </div>
          <div class="arch-stat-row">
            <div class="arch-stat"><div class="arch-stat-num">12 wks</div><div class="arch-stat-label">Avg migration time</div></div>
            <div class="arch-stat"><div class="arch-stat-num">0</div><div class="arch-stat-label">Downtime incidents</div></div>
            <div class="arch-stat"><div class="arch-stat-num">40+</div><div class="arch-stat-label">Migrations delivered</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── SERVICE 04 — MACHINE LEARNING ────────────── -->
<section class="service-section" data-screen-label="05 Machine Learning">
  <div class="wrap">
    <div class="svc-grid flip reveal">
      <div>
        <div class="svc-num">04</div>
        <h2 class="svc-h2">Machine Learning &amp; AI</h2>
        <p class="svc-desc">From demand forecasting to anomaly detection — we take models from notebook to production. Azure ML pipelines, feature stores, MLflow tracking, and real-time inference endpoints that scale with load.</p>
        <div class="svc-features">
          <div class="svc-feat">
            <div class="feat-check" style="background:#7c3aed"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Production ML pipelines.</strong> Automated retraining, model versioning, and A/B traffic splitting via Azure ML endpoints.</div>
          </div>
          <div class="svc-feat">
            <div class="feat-check" style="background:#7c3aed"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Feature store engineering.</strong> Point-in-time correctness, offline/online sync, and versioned feature pipelines across teams.</div>
          </div>
          <div class="svc-feat">
            <div class="feat-check" style="background:#7c3aed"><svg viewBox="0 0 12 9"><polyline points="1.5 4.5 4.5 7.5 10.5 1.5"/></svg></div>
            <div class="feat-text"><strong>Azure OpenAI integration.</strong> RAG pipelines, vector search with CosmosDB, and LLM-powered data products for enterprise teams.</div>
          </div>
        </div>
        <a class="svc-link" href="/services/machine-learning">Read the ML whitepaper <span class="svc-arrow"><svg viewBox="0 0 13 13"><line x1="2" y1="11" x2="11" y2="2"/><polyline points="5 2 11 2 11 8"/></svg></span></a>
      </div>
      <div class="svc-panel">
        <div class="panel-ml">
          <div class="ml-header"><div class="ml-header-title">Azure ML — Model Registry</div><span class="ml-badge">4 in production</span></div>
          <div class="ml-model">
            <div class="ml-model-ico" style="background:#f3e8ff"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
            <div style="flex:1">
              <div class="ml-model-name">Demand Forecasting v3.2</div>
              <div class="ml-model-type">GradientBoostingRegressor · Deployed</div>
              <div class="ml-model-foot">
                <div class="ml-metric"><div class="ml-metric-val">94.3%</div><div class="ml-metric-label">Accuracy</div></div>
                <div class="ml-metric"><div class="ml-metric-val">0.041</div><div class="ml-metric-label">MAE</div></div>
                <div class="ml-metric"><div class="ml-metric-val">12ms</div><div class="ml-metric-label">Latency</div></div>
              </div>
              <div class="ml-prog"><div class="ml-prog-fill" style="width:94.3%"></div></div>
            </div>
          </div>
          <div class="ml-model">
            <div class="ml-model-ico" style="background:#e8f0fe"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a73e8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
            <div style="flex:1">
              <div class="ml-model-name">Anomaly Detection v1.8</div>
              <div class="ml-model-type">IsolationForest · Deployed</div>
              <div class="ml-model-foot">
                <div class="ml-metric"><div class="ml-metric-val">97.1%</div><div class="ml-metric-label">Precision</div></div>
                <div class="ml-metric"><div class="ml-metric-val">0.003</div><div class="ml-metric-label">FPR</div></div>
                <div class="ml-metric"><div class="ml-metric-val">8ms</div><div class="ml-metric-label">Latency</div></div>
              </div>
              <div class="ml-prog"><div class="ml-prog-fill" style="width:97.1%;background:linear-gradient(90deg,#1a73e8,#00d4e8)"></div></div>
            </div>
          </div>
          <div class="ml-model">
            <div class="ml-model-ico" style="background:#e6f4ea"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#137333" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
            <div style="flex:1">
              <div class="ml-model-name">Churn Predictor v2.0</div>
              <div class="ml-model-type">XGBoostClassifier · Staging</div>
              <div class="ml-model-foot">
                <div class="ml-metric"><div class="ml-metric-val">89.6%</div><div class="ml-metric-label">AUC-ROC</div></div>
                <div class="ml-metric"><div class="ml-metric-val">0.88</div><div class="ml-metric-label">F1</div></div>
                <div class="ml-metric"><div class="ml-metric-val">18ms</div><div class="ml-metric-label">Latency</div></div>
              </div>
              <div class="ml-prog"><div class="ml-prog-fill" style="width:89.6%;background:linear-gradient(90deg,#137333,#00dd6a)"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── SERVICE 05 — IoT ──────────────────────────── -->
<section class="service-section" data-screen-label="06 IoT">
  <div class="wrap">
    <div class="svc-grid reveal">
      <div>
        <div class="svc-num">05</div>
        <h2 class="svc-h2">IoT &amp; Edge Intelligence</h2>
        <p class="svc-desc">We connect fleets of devices to the cloud — provisioning, telemetry routing, edge inference, and the operational dashboards to manage it all. Thousands of devices, one platform.</p>
        <div class="svc-features">
